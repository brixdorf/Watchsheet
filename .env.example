# ---- server ----
PORT=3000
NODE_ENV=development
# Used to sign session cookies. Generate one: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=change-me
DATABASE_PATH=./data/watchsheet.db
# Proxies in front of the app. Cloudflare plus Traefik is 2; a bare origin is 0. Wrong and
# req.ip becomes a proxy's address, putting every visitor in one rate-limit bucket.
TRUST_PROXY_HOPS=2
# Comma-separated. These accounts, and only these, can open the admin screen.
ADMIN_EMAILS=admin@example.com

# ---- Highlightly (soccer.highlightly.net) ----
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_BASE_URL=https://soccer.highlightly.net
# Free tier is 100 requests/day. Stay under it so manual runs always have headroom.
HIGHLIGHTLY_DAILY_BUDGET=85

# ---- fixture sync ----
SYNC_ENABLED=true
# Requests spent per hourly cron tick.
SYNC_SLICE=6

# ---- email / OTP ----
# console = log the code to the server output (default, no provider needed)
# resend  = live sending through Resend; needs RESEND_API_KEY + MAIL_FROM
MAIL_PROVIDER=console
# Show the OTP on the verify screen too. Development only.
OTP_DEV_ECHO=true
MAIL_FROM="Watchsheet <no-reply@example.com>"
# Replies to a no-reply sender have to land somewhere, so point them at the real mailbox.
MAIL_REPLY_TO=hi@example.com
RESEND_API_KEY=
# Codes one caller can request per hour, across every address. 0 turns the limit off.
OTP_IP_PER_HOUR=10
