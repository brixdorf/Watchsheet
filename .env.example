# ---- server ----
PORT=3000
NODE_ENV=development
# Used to sign session cookies. Generate one: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=change-me
DATABASE_PATH=./data/watchsheet.db
# Proxies in front of the app. Cloudflare plus Traefik is 2; a bare origin is 0. Wrong and
# req.ip becomes a proxy's address, putting every visitor in one rate-limit bucket.
TRUST_PROXY_HOPS=2
# Comma-separated. These accounts, and only these, can open the admin screen.
ADMIN_EMAILS=

# ---- Highlightly (soccer.highlightly.net) ----
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_BASE_URL=https://soccer.highlightly.net
# Free tier is 100 requests/day. Stay under it so manual runs always have headroom.
HIGHLIGHTLY_DAILY_BUDGET=85

# ---- fixture sync ----
SYNC_ENABLED=true
# Requests spent per hourly cron tick. The cron fires 24 times a day, so the ceiling is
# 24 x this, and it must stay under HIGHLIGHTLY_DAILY_BUDGET or the allowance runs out
# before the evening's kick-offs. 3 gives 72 a day and leaves room for a manual run.
SYNC_SLICE=3

# ---- email / OTP ----
# Live mail needs both. MAIL_FROM must be on a domain verified in your Resend account, for
# example "Watchsheet <auth@mail.example.com>". Without a key, the code is printed to the
# server output instead.
RESEND_API_KEY=
MAIL_FROM=
# Optional. Where replies to a sign-in email go.
MAIL_REPLY_TO=
# Show the OTP on the verify screen too, only while delivery is local. Development only.
OTP_DEV_ECHO=true
# MAIL_PROVIDER=resend        (resend when a key is set, console otherwise)
# Codes one caller can request per hour, across every address. 0 turns the limit off.
OTP_IP_PER_HOUR=10
